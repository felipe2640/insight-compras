EVALUATE
ADDCOLUMNS(
    SUMMARIZE(
        TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819,
        TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[DATAFLOW_ID]
    ),
    "Linhas", CALCULATE(COUNTROWS(TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819)),
    "Pares distintos", CALCULATE(COUNTROWS(SUMMARIZE(TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819, TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO], TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE], TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[TIPO]))),
    "Origem orfa", CALCULATE(COALESCE(COUNTROWS(FILTER(TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819, NOT TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO] IN SELECTCOLUMNS(PRODUTOS, "Codigo", PRODUTOS[ACODPRODUTO]))), 0)),
    "Destino orfao", CALCULATE(COALESCE(COUNTROWS(FILTER(TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819, NOT TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE] IN SELECTCOLUMNS(PRODUTOS, "Codigo", PRODUTOS[ACODPRODUTO]))), 0))
)
ORDER BY TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[DATAFLOW_ID]
