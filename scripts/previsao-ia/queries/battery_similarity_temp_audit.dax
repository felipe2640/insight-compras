EVALUATE
VAR _Pairs =
    ADDCOLUMNS(
        TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819,
        "DescricaoOrigem", LOOKUPVALUE(PRODUTOS[ADESCRICAO], PRODUTOS[ACODPRODUTO], TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO]),
        "SaldoOrigem", LOOKUPVALUE(PRODUTOS[NESTOQATUAL], PRODUTOS[ACODPRODUTO], TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO]),
        "DescricaoDestino", LOOKUPVALUE(PRODUTOS[ADESCRICAO], PRODUTOS[ACODPRODUTO], TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE]),
        "SaldoDestino", LOOKUPVALUE(PRODUTOS[NESTOQATUAL], PRODUTOS[ACODPRODUTO], TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE])
    )
VAR _BatteryProducts =
    FILTER(PRODUTOS, CONTAINSSTRING(UPPER(PRODUTOS[ADESCRICAO]), "BATERIA"))
VAR _BatteryPairs =
    FILTER(_Pairs, CONTAINSSTRING(UPPER([DescricaoOrigem]), "BATERIA"))
RETURN
ROW(
    "Produtos bateria", COUNTROWS(_BatteryProducts),
    "Produtos bateria com similar", COUNTROWS(INTERSECT(SELECTCOLUMNS(_BatteryProducts, "Codigo", PRODUTOS[ACODPRODUTO]), SELECTCOLUMNS(_BatteryPairs, "Codigo", TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO]))),
    "Pares com origem bateria", COUNTROWS(_BatteryPairs),
    "Pares bateria para bateria", COUNTROWS(FILTER(_BatteryPairs, CONTAINSSTRING(UPPER([DescricaoDestino]), "BATERIA"))),
    "Baterias zeradas com similar positivo", COUNTROWS(SUMMARIZE(FILTER(_BatteryPairs, COALESCE([SaldoOrigem],0) <= 0 && COALESCE([SaldoDestino],0) > 0), TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO]))
)
