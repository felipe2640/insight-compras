EVALUATE
VAR _T = TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819
VAR _DupGroups =
    FILTER(
        GROUPBY(
            _T,
            TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO],
            TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE],
            TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[TIPO],
            "Linhas", COUNTX(CURRENTGROUP(), 1)
        ),
        [Linhas] > 1
    )
RETURN
ROW(
    "Linhas", COUNTROWS(_T),
    "Pares distintos", COUNTROWS(SUMMARIZE(_T, TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO], TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE], TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[TIPO])),
    "Grupos duplicados", COUNTROWS(_DupGroups),
    "Linhas excedentes duplicadas", SUMX(_DupGroups, [Linhas] - 1),
    "Origem vazia", COUNTROWS(FILTER(_T, ISBLANK(TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO]) || TRIM(TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO]) = "")),
    "Destino vazio", COUNTROWS(FILTER(_T, ISBLANK(TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE]) || TRIM(TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE]) = "")),
    "Auto referencia", COUNTROWS(FILTER(_T, TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO] = TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE])),
    "Origem orfa", COALESCE(COUNTROWS(FILTER(_T, NOT TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO] IN SELECTCOLUMNS(PRODUTOS, "Codigo", PRODUTOS[ACODPRODUTO]))), 0),
    "Destino orfao", COALESCE(COUNTROWS(FILTER(_T, NOT TMP_AUDIT_PRODUTOS_SEMELHANTES_20260819[ACODPRODUTO_SEMELHANTE] IN SELECTCOLUMNS(PRODUTOS, "Codigo", PRODUTOS[ACODPRODUTO]))), 0)
)
