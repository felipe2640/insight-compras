{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "insight-compras",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "env": {
        "CARREIRO_PREFERIR_SNAPSHOT": "true"
      }
    },
    {
      "name": "insight-compras-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000,
      "env": {
        "CARREIRO_PREFERIR_SNAPSHOT": "true"
      }
    }
  ]
}