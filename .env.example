# ==============================================================================
# CONFIGURAÇÃO DE AMBIENTE: iNSIGHT D (insight-compras)
# ==============================================================================

# --- CONEXÃO AO MODELO SEMÂNTICO VIVO (POWER BI / FABRIC REST API) ---
# Endpoint: https://api.powerbi.com/v1.0/myorg/groups/${POWERBI_WORKSPACE_ID}/datasets/${POWERBI_DATASET_ID}/executeQueries
POWERBI_WORKSPACE_ID="6bf4ec9d-2d71-48cf-b742-3460847d8036"
POWERBI_DATASET_ID="a1ac5650-ca05-4a08-9593-5550ab67e14b"

# Autenticação OAuth2 via Service Principal (Azure Entra ID)
POWERBI_TENANT_ID=""
POWERBI_CLIENT_ID=""
POWERBI_CLIENT_SECRET=""

# Alternativa: Access Token pré-gerado (útil para testes manuais rápidos)
# POWERBI_ACCESS_TOKEN=""

# --- ADAPTADOR E SNAPSHOT LOCAL (OFFLINE / HOMOLOGAÇÃO) ---
# Se USE_MOCK_ADAPTER="true", força o gerador determinístico Mulberry32 (25.000 SKUs)
USE_MOCK_ADAPTER="false"

# Diretório customizado de dados reais extraídos (se omitido, busca nas pastas padrão locais)
# CARREIRO_DATA_DIR="c:/Users/Felipe Barbosa/Documents/diario/scratch/carreiro_20260903/raw"

# --- CICLO DE APRENDIZADO (modelo × comprador) — opcional; sem estas variáveis tudo vira no-op ---
# URL do projeto Supabase e chave service_role (server-only). Esquema: docs/supabase/schema-aprendizado.sql
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Chave pública (publishable/anon) usada só para o login por senha (GoTrue). Pode ir ao navegador.
SUPABASE_ANON_KEY=
# Provedor de autenticação: supabase | demo (padrão: supabase se as chaves existirem, senão demo)
AUTH_PROVIDER=
